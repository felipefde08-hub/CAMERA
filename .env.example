CAMPEX_ENV=development
CAMPEX_SERVICE_NAME=campex
CAMPEX_VERSION=0.1.0
CAMPEX_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./storage/campex_dev.sqlite3
CAMPEX_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CAMERA_RECONNECT_SECONDS=5
CAMERA_STALE_SECONDS=10
CAMERA_READ_FAILURE_LIMIT=3
CAMERA_TEST_TIMEOUT_SECONDS=5
VISION_ENABLED=true
VISION_DETECTOR=rfdetr
VISION_DEVICE=auto
VISION_FPS=5
VISION_CONFIDENCE=0.50
VISION_VIDEO_LOOP=true
